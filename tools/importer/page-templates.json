{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "faqs",
      "urls": [
        "https://wknd.site/us/en/faqs.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/faqs.html",
      "description": "WKND FAQ page: stacked title + image hero, intro text, FAQ accordion, contact help sidebar",
      "urlPattern": "/us/en/*",
      "blocks": [
        {
          "name": "hero-stacked",
          "instances": [
            ".title.cmp-title--underline"
          ]
        },
        {
          "name": "accordion-faq",
          "instances": [
            ".accordion.panelcontainer .cmp-accordion"
          ]
        }
      ],
      "sections": [
        {
          "id": "1",
          "name": "Hero",
          "selector": [
            ".title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [
            "hero-stacked"
          ],
          "defaultContent": []
        },
        {
          "id": "2",
          "name": "Intro and FAQ list",
          "selector": [
            ".text.aem-GridColumn--default--8"
          ],
          "style": null,
          "blocks": [
            "accordion-faq"
          ],
          "defaultContent": [
            ".text.aem-GridColumn--default--8 .cmp-text"
          ]
        },
        {
          "id": "3",
          "name": "Contact help (sidebar)",
          "selector": [
            ".container.responsivegrid.aem-GridColumn--default--3"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            ".container.responsivegrid.aem-GridColumn--default--3 .cmp-title",
            ".container.responsivegrid.aem-GridColumn--default--3 .cmp-text"
          ]
        }
      ]
    }
  ]
}
